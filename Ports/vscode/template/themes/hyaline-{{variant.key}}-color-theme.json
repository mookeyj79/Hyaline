  "tokenColors": [
    {
      "name": "Variables and plain text",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite",
        "meta.embedded",
        "source"
      ],
      "settings": {
        "foreground": "{{text}}"
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "markup.list.unnumbered",
        "markup.list.numbered",
        "beginning.punctuation.definition.list.markdown",
        "markup.quote"
      ],
      "settings": {
        "foreground": "{{text_dim}}"
      }
    },
    {
      "name": "Keywords, booleans, constants",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "variable.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "{{magenta}}"
      }
    },
    {
      "name": "Keys, properties, functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.other.attribute-name",
        "entity.name.tag.yaml",
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "{{blue}}"
      }
    },
    {
      "name": "Types, references, anchors",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.module",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.other.namespace",
        "storage.type.primitive",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "{{cyan}}"
      }
    },
    {
      "name": "Tags, annotations, decorators",
      "scope": [
        "entity.name.tag",
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "{{yellow}}"
      }
    },
    {
      "name": "Numbers and literals",
      "scope": [
        "constant.numeric",
        "constant.character.escape",
        "keyword.other.unit",
        "support.constant.property-value",
        "constant.other.color",
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "{{orange}}"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.regexp"
      ],
      "settings": {
        "foreground": "{{green}}"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "{{text_muted}}"
      }
    },
    {
      "name": "Errors and invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "{{red}}"
      }
    },
    {
      "name": "Diff: ranges",
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "{{blue}}"
      }
    },
    {
      "name": "Diff: added",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "{{green}}"
      }
    },
    {
      "name": "Diff: removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "{{red}}"
      }
    },
    {
      "name": "Diff: changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "{{yellow}}"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "{{cyan}}",
    "type": "{{cyan}}",
    "class": "{{cyan}}",
    "enum": "{{cyan}}",
    "interface": "{{cyan}}",
    "struct": "{{cyan}}",
    "typeParameter": "{{cyan}}",
    "label": "{{cyan}}",
    "parameter": "{{text}}",
    "variable": "{{text}}",
    "property": "{{blue}}",
    "function": "{{blue}}",
    "method": "{{blue}}",
    "enumMember": "{{magenta}}",
    "keyword": "{{magenta}}",
    "macro": "{{magenta}}",
    "event": "{{yellow}}",
    "decorator": "{{yellow}}",
    "comment": "{{text_muted}}",
    "string": "{{green}}",
    "regexp": "{{green}}",
    "number": "{{orange}}",
    "operator": "{{text_dim}}"
  }
}
